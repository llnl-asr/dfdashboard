{
  "name": "dfdashboard-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "DFDashboard frontend: Perfetto-style trace timeline over the FastAPI backend",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@solidjs/router": "^0.14.10",
    "@uwdata/flechette": "^2.5.0",
    "apache-arrow": "^18.0.0",
    "cytoscape": "3.30.2",
    "cytoscape-dagre": "2.5.0",
    "fzstd": "^0.1.1",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/cytoscape": "3.21.9",
    "@types/node": "^20.16.0",
    "eslint": "^9.13.0",
    "eslint-plugin-solid": "^0.14.5",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.1.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
